name: Course Management Portal Frontend

on:
  push:
    branches:
      - main

jobs:
  deploy:
    runs-on: self-hosted

    steps:
      #checkout the repo
      - name: Checkout Repository
        uses: actions/checkout@v3
        with:
          token: ${{  secrets.MY_KEY }}

      - name: Pull the latest code
        run: |
          cd /home/node3/course-portal/frontend/course_management_portal_frontend
          git config --global --add safe.directory /home/node3/course-portal/frontend/course_management_portal_frontend
          git config user.email "kavindya@futurecx.com"
          git config user.name "Kavee-Dewa-26"

          # remove old remotes if exists
          git remote remove source || true
  
          git remote add source https://github.com/SapnaNethmini/course_management_portal_frontend.git
          git remote add origin https://${{ secrets.MY_KEY }}@github.com/Kavee-Dewa-26/course_management_portal_frontend.git

          git remote add frontend https://github.com/SapnaNethmini/course_management_portal_frontend.git
          git pull origin main

      

      - name: Deploy the containers
        run: |
          cd /home/node3/course-portal/frontend/course_management_portal_frontend
          docker-compose stop course-frontend || true
          docker system prune -af || true
          docker-compose up -d course-frontend
          docker ps
